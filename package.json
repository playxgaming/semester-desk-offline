{
  "name": "semester-desk",
  "private": true,
  "version": "3.0.2",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "Offline-first PWA for the whole semester: courses, timetable, attendance, deadlines, grades, spaced repetition and a load-aware study planner.",
  "scripts": {
    "dev": "vite",
    "chatgpt:setup": "node scripts/chatgpt-local/setup.mjs",
    "chatgpt:start": "node scripts/chatgpt-local/start.mjs",
    "chatgpt:test": "node --test scripts/chatgpt-local/test.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-release.mjs",
    "docs:screenshots": "node scripts/capture-docs.mjs",
    "check": "esbuild scripts/check.ts --bundle --platform=node --format=cjs --outfile=node_modules/.check.cjs --log-level=error --loader:.css=empty --define:import.meta.env={} && node node_modules/.check.cjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs",
    "android:release": "npm run android:sync && node scripts/android-build.mjs --release",
    "audit:mobile": "node scripts/mobile-audit.mjs",
    "audit:flows": "node scripts/flow-test.mjs",
    "capacitor:sync:after": "node scripts/android-compat.mjs",
    "capacitor:update:after": "node scripts/android-compat.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/status-bar": "^6.0.3",
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@tesseract.js-data/eng": "1.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "katex": "0.19.1",
    "lucide-react": "^0.446.0",
    "pdfjs-dist": "6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "^2.12.7",
    "tesseract.js": "7.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "7.6.10",
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "7.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "glob": "14.0.6",
    "minimatch": "11.0.8"
  }
}
